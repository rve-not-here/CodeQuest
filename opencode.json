{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "@playwright/mcp@latest",
                "--headless",
                "--executable-path",
                "/home/vmc/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome"
            ]
        },
        "figma": {
            "type": "remote",
            "enabled": true,
            "url": "https://mcp.figma.com/mcp"
        }
    }
}
